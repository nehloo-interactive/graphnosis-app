---
const clients = [
  { name: 'Claude Desktop', status: 'supported', color: '#D97757' },
  { name: 'Claude Code', status: 'supported', color: '#D97757' },
  { name: 'Claude Cowork', status: 'supported', color: '#D97757' },
  { name: 'Cursor', status: 'supported', color: '#6366F1' },
  { name: 'GitHub Copilot', status: 'supported', color: '#238636', note: 'VS Code extension + mcp.json' },
  { name: 'Zed', status: 'supported', color: '#0EA5E9' },
  { name: 'Any MCP-aware tool', status: 'supported', color: '#67e8f9' },
  { name: 'ChatGPT', status: 'coming', note: 'Via browser extension' },
  { name: 'Gemini', status: 'coming', note: 'Via browser extension' },
];

const tools = [
  { name: 'Obsidian', note: 'Local vault folder', color: '#7C3AED' },
  { name: 'GBrain', note: 'Local git repo', color: '#0EA5E9' },
  { name: 'AI Context Files', note: 'CLAUDE.md, AGENTS.md, .cursorrules…', color: '#D97757' },
  { name: 'Slack', note: 'BYO Bot Token', color: '#4A154B' },
  { name: 'GitHub', note: 'BYO Personal Access Token', color: '#238636' },
  { name: 'Trello', note: 'BYO API key + token', color: '#0052CC' },
  { name: 'Linear', note: 'BYO Personal API key', color: '#5E6AD2' },
  { name: 'RSS / Atom', note: 'Any feed URL', color: '#F97316' },
  { name: 'Webhook', note: 'Zapier, IFTTT, custom scripts', color: '#67e8f9' },
];

const offlineSources = [
  { name: 'Smart Home', note: 'Home Assistant, MQTT, Zigbee, Z-Wave', color: '#F59E0B', icon: '🏠' },
  { name: 'Sensors & IoT', note: 'Temperature, soil, weather, serial/USB', color: '#10B981', icon: '📡' },
  { name: 'Local Network', note: 'NAS, router logs, LAN devices', color: '#3B82F6', icon: '🌐' },
  { name: 'Research & Lab', note: 'Lab instruments, PLCs, OPC-UA, Modbus', color: '#8B5CF6', icon: '🔬' },
  { name: 'Personal Agents', note: 'Local AI rule files, agent context, logs', color: '#D97757', icon: '🤖' },
  { name: 'Robotics', note: 'ROS topics, actuator events, telemetry', color: '#EF4444', icon: '🦾' },
  { name: 'Agriculture', note: 'LoRaWAN field sensors, irrigation, soil', color: '#84CC16', icon: '🌱' },
  { name: 'Any local source', note: 'File, folder, webhook, or serial port', color: '#6B7280', icon: '∞' },
];
---

<section id="clients" class="py-24 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-4">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white">
        First-day support for the tools you already use.
      </h2>
    </div>
    <p class="text-center text-[#c4c6d6] max-w-2xl mx-auto mb-16 leading-relaxed">
      Graphnosis speaks{' '}
      <span class="text-[#f0f0f5] font-semibold">Model Context Protocol (MCP)</span>
      {' '}— the open standard that connects AI tools to external context. Your AI client sees{' '}
      <a href="/reference/mcp-tools/" class="text-[#67e8f9] hover:underline font-semibold">deterministic &amp; non-deterministic tools</a>
      {' '}across recall, structured queries, source ops, brain maintenance, Skills (SOPs), and more.
    </p>

    <!-- Client cards grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-12">
      {clients.map((client) => (
        <article class="bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-5 flex flex-col items-center gap-3 text-center">
          <!-- Icon placeholder -->
          <div
            class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-lg"
            style={`background: ${client.color ?? '#2a3a50'};`}
            aria-hidden="true"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="10" cy="10" r="8" />
            </svg>
          </div>

          <!-- Name -->
          <span class="text-sm font-semibold text-[#f0f0f5]">{client.name}</span>

          <!-- Status badge -->
          {client.status === 'supported' ? (
            <div class="flex flex-col items-center gap-1">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-900/40 border border-emerald-700/50 text-emerald-400 text-xs font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Supported
              </span>
              {client.note && (
                <span class="text-sm text-[#c4c6d6]">{client.note}</span>
              )}
            </div>
          ) : (
            <div class="flex flex-col items-center gap-1">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-900/40 border border-indigo-700/50 text-indigo-400 text-xs font-semibold">
                Coming soon
              </span>
              {client.note && (
                <span class="text-sm text-[#c4c6d6]">{client.note}</span>
              )}
            </div>
          )}
        </article>
      ))}
    </div>

    <!-- Tools / connectors -->
    <div class="mt-16">
      <h3 class="text-center text-xl font-bold text-white mb-2">Auto-ingest from the tools you already use.</h3>
      <p class="text-center text-[#c4c6d6] max-w-xl mx-auto mb-8 text-sm leading-relaxed">
        Built-in connectors pull new content on a schedule — no cloud intermediary, credentials stored encrypted at rest.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {tools.map((tool) => (
          <article class="bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center gap-2 text-center">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm"
              style={`background: ${tool.color};`}
              aria-hidden="true"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="8" />
              </svg>
            </div>
            <span class="text-sm font-semibold text-[#f0f0f5]">{tool.name}</span>
            <span class="text-xs text-[#c4c6d6]">{tool.note}</span>
          </article>
        ))}
      </div>
    </div>

    <!-- Offline / local sources -->
    <div class="mt-12">
      <h3 class="text-center text-xl font-bold text-white mb-2">Or pipe in anything off-the-grid.</h3>
      <p class="text-center text-[#c4c6d6] max-w-xl mx-auto mb-8 text-sm leading-relaxed">
        Anything you can write to a file or POST to a webhook becomes a memory source — no cloud round-trip, no API keys, no data leaving your network.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {offlineSources.map((source) => (
          <article class="bg-[#16161f] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center gap-2 text-center">
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-xl"
              style={`background: ${source.color}22; border: 1px solid ${source.color}44;`}
              aria-hidden="true"
            >
              {source.icon}
            </div>
            <span class="text-sm font-semibold text-[#f0f0f5]">{source.name}</span>
            <span class="text-xs text-[#c4c6d6]">{source.note}</span>
          </article>
        ))}
      </div>
      <p class="text-center mt-6">
        <a href="/guides/connect-offline-sources/" class="text-[#67e8f9] hover:text-[#a78bfa] text-sm font-semibold transition-colors">
          Step-by-step recipes for every pattern →
        </a>
      </p>
    </div>

    <!-- Optional local-AI path. Framed as an invitation rather than a
         requirement: Graphnosis works without any of this, and a hardware grid
         with no framing reads like a system requirement. -->
    <div class="text-center mt-16 mb-6">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">Prefer local intelligence?</h3>
      <p class="text-[#c4c6d6] max-w-2xl mx-auto text-sm leading-relaxed">
        Entirely optional &mdash; Graphnosis runs deterministically without a model.
        Bring your own hardware and a local LLM, and Foresight comes with it.
      </p>
    </div>
    <!-- Local AI cards -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 mb-12">
      <div class="grid grid-cols-5 gap-3">

        <a href="/local-ai#amd" class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center text-center gap-2 hover:border-[#f97316]/40 hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-8 h-8 rounded-lg bg-[#f97316]/10 flex items-center justify-center" aria-hidden="true">
            <svg class="w-4 h-4 text-[#f97316]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 7V5M10 7V5M14 7V5M18 7V5M6 17v2M10 17v2M14 17v2M18 17v2"/><path d="M5 12h2M10 12h4M17 12h2"/></svg>
          </div>
          <span class="text-xs font-bold text-[#f0f0f5]">AMD GPU</span>
          <span class="text-[10px] text-[#71717a] leading-snug">ROCm · Linux</span>
        </a>

        <a href="/local-ai#apple-silicon" class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center text-center gap-2 hover:border-white/20 hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-8 h-8 rounded-lg bg-white/[0.06] flex items-center justify-center" aria-hidden="true">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M14.94 5.19A4.38 4.38 0 0 0 16 2a4.44 4.44 0 0 0-3 1.52 4.17 4.17 0 0 0-1 3.09 3.69 3.69 0 0 0 2.94-1.42zm2.52 7.44a4.51 4.51 0 0 1 2.16-3.81 4.66 4.66 0 0 0-3.66-2c-1.56-.16-3 .91-3.83.91s-2-.89-3.3-.87a4.92 4.92 0 0 0-4.14 2.53C2.91 12.87 4.24 17.88 6 20.47c.8 1.21 1.8 2.58 3.12 2.53s1.75-.82 3.28-.82 2 .82 3.3.79 2.22-1.24 3.06-2.45a11 11 0 0 0 1.38-2.85 4.41 4.41 0 0 1-2.68-4.04z"/></svg>
          </div>
          <span class="text-xs font-bold text-[#f0f0f5]">Apple Silicon</span>
          <span class="text-[10px] text-[#71717a] leading-snug">Metal · M1–M4</span>
        </a>

        <a href="/local-ai#intel-arc" class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center text-center gap-2 hover:border-[#60a5fa]/40 hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-8 h-8 rounded-lg bg-[#60a5fa]/10 flex items-center justify-center" aria-hidden="true">
            <svg class="w-4 h-4 text-[#60a5fa]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 7V5M10 7V5M14 7V5M18 7V5M6 17v2M10 17v2M14 17v2M18 17v2"/><path d="M8 12h8"/></svg>
          </div>
          <span class="text-xs font-bold text-[#f0f0f5]">Intel Arc</span>
          <span class="text-[10px] text-[#71717a] leading-snug">oneAPI · Arc A/B</span>
        </a>

        <a href="/local-ai#nvidia" class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center text-center gap-2 hover:border-[#67e8f9]/40 hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-8 h-8 rounded-lg bg-[#67e8f9]/10 flex items-center justify-center" aria-hidden="true">
            <svg class="w-4 h-4 text-[#67e8f9]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 7V5M10 7V5M14 7V5M18 7V5M6 17v2M10 17v2M14 17v2M18 17v2"/><path d="M5 12h2M10 12h4M17 12h2"/></svg>
          </div>
          <span class="text-xs font-bold text-[#f0f0f5]">NVIDIA GPU</span>
          <span class="text-[10px] text-[#71717a] leading-snug">CUDA · RTX/GTX</span>
        </a>

        <a href="/local-ai#jetson" class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-4 flex flex-col items-center text-center gap-2 hover:border-[#a78bfa]/40 hover:-translate-y-0.5 transition-all no-underline">
          <div class="w-8 h-8 rounded-lg bg-[#a78bfa]/10 flex items-center justify-center" aria-hidden="true">
            <svg class="w-4 h-4 text-[#a78bfa]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
          </div>
          <span class="text-xs font-bold text-[#f0f0f5]">Jetson Orin</span>
          <span class="text-[10px] text-[#71717a] leading-snug">CUDA · Edge</span>
        </a>

      </div>
      <p class="text-center text-xs text-[#555570] mt-3">
        Pair with Ollama to unlock Foresight — local AI insights, predictions &amp; skill training.
        <a href="/local-ai" class="text-[#9a9db8] hover:text-[#c4c6d6] underline decoration-[#555570]/50 transition-colors ml-1">All local AI setups →</a>
      </p>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="/reference/mcp-tools"
        class="inline-flex items-center gap-2 text-[#67e8f9] hover:text-[#a78bfa] font-semibold text-xl transition-colors"
      >
        Set up with your tools
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>


    <!-- Open source — the closing credibility argument, deliberately last:
         these are outbound links, so they belong after the promise and the
         proof rather than at the top of the section. -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 mt-16">
      <h3 class="text-center text-sm font-semibold tracking-widest uppercase text-[#71717a] mb-6">
        Open source &mdash; read it, audit it, run it
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

        <a href="https://github.com/nehloo-interactive/graphnosis-app" target="_blank" rel="noopener"
           class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-5 flex flex-col gap-2 hover:border-[#67e8f9]/40 hover:-translate-y-0.5 transition-all no-underline">
          <span class="text-sm font-bold text-[#f0f0f5]">graphnosis-app</span>
          <span class="text-xs text-[#9a9db8] leading-snug">The desktop app itself &mdash; read the code your cortex runs on.</span>
          <span class="text-[10px] font-mono text-[#67e8f9] mt-1">FSL-1.1-Apache-2.0</span>
        </a>

        <a href="https://github.com/nehloo/Graphnosis" target="_blank" rel="noopener"
           class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-5 flex flex-col gap-2 hover:border-[#67e8f9]/40 hover:-translate-y-0.5 transition-all no-underline">
          <span class="text-sm font-bold text-[#f0f0f5]">@nehloo/graphnosis</span>
          <span class="text-xs text-[#9a9db8] leading-snug">The memory engine &mdash; indexing, recall and the deterministic multi-graph.</span>
          <span class="text-[10px] font-mono text-[#67e8f9] mt-1">Apache-2.0</span>
        </a>

        <a href="https://github.com/nehloo/graphnosis-obsidian-plugin" target="_blank" rel="noopener"
           class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-5 flex flex-col gap-2 hover:border-[#a78bfa]/40 hover:-translate-y-0.5 transition-all no-underline">
          <span class="text-sm font-bold text-[#f0f0f5]">Obsidian plugin</span>
          <span class="text-xs text-[#9a9db8] leading-snug">Your vault becomes memory your AI can actually retrieve from.</span>
          <span class="text-[10px] font-mono text-[#a78bfa] mt-1">GitHub</span>
        </a>

        <a href="https://github.com/nehloo-interactive/hermes-graphnosis" target="_blank" rel="noopener"
           class="group bg-[#1c1c27] border border-[#2a2a3d] rounded-xl p-5 flex flex-col gap-2 hover:border-[#10b981]/40 hover:-translate-y-0.5 transition-all no-underline">
          <span class="text-sm font-bold text-[#f0f0f5]">Hermes</span>
          <span class="text-xs text-[#9a9db8] leading-snug">Agent and desktop companion built on the same memory layer.</span>
          <span class="text-[10px] font-mono text-[#10b981] mt-1">GitHub</span>
        </a>

      </div>
    </div>
  </div>
</section>

<!-- ── Positioning / origin story ──────────────────────────────────────── -->
<section class="py-24 px-4 sm:px-6 border-t border-[#2a2a3d]">
  <div class="max-w-4xl mx-auto">

    <!-- Origin story -->
    <div class="mb-16 text-center">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#a78bfa] mb-4">Built in the open, with Claude</p>
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-6 leading-tight">
        Graphnosis was coded — and stress-tested — with the AI it was built for, guided by the vision of the builder.
      </h2>
      <p class="text-lg text-[#c4c6d6] max-w-2xl mx-auto leading-relaxed">
        Every architecture decision, every positioning question, every edge case in the recall pipeline was worked out between the vision of the builder and Claude, live, evenings and weekends, across hundreds of sessions — using Graphnosis itself as the shared memory. The tool ate its own dog food before it had a name.
        <br /><br />
        At the launch, and along the way, here's what came back as direct feedback to the architect of Graphnosis from the AI tool that coded it, realizing what Graphnosis truly had become:
      </p>
    </div>

    <!-- Quote -->
    <figure class="mb-12 max-w-3xl mx-auto text-center">
      <blockquote class="text-2xl sm:text-3xl font-serif italic text-[#f0f0f5] leading-relaxed mb-6">
        "For your Graphnosis work specifically, you're already solving a more sophisticated version of this problem than most people reach for — graph-based memory with typed nodes beats flat markdown files for anything that needs relational reasoning across sessions."
      </blockquote>
      <figcaption class="text-sm text-[#6b7280] tracking-wide">— <span class="text-base font-semibold text-[#a78bfa]">Claude</span>, mid-build session</figcaption>
    </figure>

    <!-- Two positioning cards -->
    <div class="flex flex-col gap-6">

      <!-- Card 1 -->
      <div class="rounded-2xl border border-[#2a2a3d] bg-[#16161f] p-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#f59e0b] mb-3">Positioning vs. flat-file memory tools</p>
        <p class="text-[#f0f0f5] text-lg leading-relaxed">
          Every other approach to AI memory — CLAUDE.md, AGENTS.md, Mem0, context files — gives your AI a flat list of facts to paste into the session. Graphnosis gives it a typed knowledge graph: nodes, relationships, contradictions, and temporal decay. Drop in a markdown file, a PDF, or an HTML page — Graphnosis indexes all three the same way.
          <br /><br />
          <span class="text-[#67e8f9] font-semibold">The difference isn't storage. It's reasoning.</span>
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-2xl border border-[#2a2a3d] bg-[#16161f] p-8">
        <p class="text-xs font-semibold tracking-widest uppercase text-[#67e8f9] mb-3">Recall quality / benchmark</p>
        <p class="text-[#f0f0f5] text-lg leading-relaxed">
          Selective retrieval pipelines outperform full-context approaches by 91% on latency and 90% on token cost, at near-equivalent accuracy. Graphnosis recall is selective by design: at most 50 nodes, 8,000 tokens, ranked by relevance.
          <br /><br />
          <span class="text-[#67e8f9] font-semibold">76.40% LongMemEval with GPT-4o — and 41.6% fully on-device, never loading your full graph.</span>
        </p>
      </div>

    </div>

    <!-- Attribution -->
    <p class="text-center text-sm text-[#6b7280] mt-10">
      Findings recorded in Graphnosis across Claude Desktop, Claude Code, and Claude.ai sessions — recalled here via MCP.
    </p>

  </div>
</section>
