---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import HeroB2B from '../components/HeroB2B.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Ghampus from '../components/Ghampus.astro';
import AIClients from '../components/AIClients.astro';
import PowerUsers from '../components/PowerUsers.astro';
import Enterprise from '../components/Enterprise.astro';
import ComingSoon from '../components/ComingSoon.astro';
import TechPrivacy from '../components/TechPrivacy.astro';
import VerifyYourself from '../components/VerifyYourself.astro';
import Newsletter from '../components/Newsletter.astro';
import Screenshots from '../components/Screenshots.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main>
    <HeroB2B />
    <!-- Tool support sits directly after the hero's Engineering / Professional /
         Operations stories: a visitor who just recognised their own workflow
         asks "does this work with my stack?" next, and the answer should not be
         eight sections away. Carries the local-AI hardware row (moved out of the
         hero, which was carrying too much) and the open-source repositories. -->
    <AIClients />
    <Screenshots />
    <Problem />
    <HowItWorks />
    <Ghampus />
    <PowerUsers />
    <Enterprise />
    <ComingSoon />
    <TechPrivacy />
    <VerifyYourself />
    <Newsletter />
  </main>
  <Footer />
</Layout>
