# Copy to .graphnosis-host.env (gitignored) and fill in.
# Used by: pnpm dev:sidecar-host / scripts/dev-push-sidecar-host.sh
#
# Privacy: put REAL hostnames, cortex paths, and secrets ONLY in
# .graphnosis-host.env — never in this example, README, commits, or chat logs.
# Prefer placeholders like you@your-host.tailnet-name.ts.net

# ── Required ──────────────────────────────────────────────────────────────
# SSH login (user@host). Tailscale MagicDNS hostname is fine.
# NOT the HTTPS personal-server / remote-cortex URL from Settings → Mobile & Remote.
# Confirm user with `whoami` on the host; confirm host with `tailscale status`.
GRAPHNOSIS_HOST=you@your-host.tailnet-name.ts.net

# ── Strongly recommended ──────────────────────────────────────────────────
# Cortex folder ON THE HOST (absolute path or ~/…).
# If unset, restart opens $HOME/.graphnosis/cortex — often a different folder
# than Graphnosis.app uses. Copy the path from the app status bar / unlock UI
# on the host, then set it here so the headless sidecar opens the same cortex.
# GRAPHNOSIS_CORTEX=/path/to/your/cortex

# Repo checkout on the host (default matches a common clone name).
GRAPHNOSIS_HOST_REPO=~/Developer/graphnosis-app

# ── Optional knobs ────────────────────────────────────────────────────────
# Defaults are already A→Z friendly: build + auto install-if-deps-changed + restart
# GRAPHNOSIS_HOST_FAST=1
# GRAPHNOSIS_HOST_RESTART=1
# GRAPHNOSIS_HOST_INSTALL=auto
# GRAPHNOSIS_HOST_INSTALL=0          # dist-only push (skip host pnpm install)
# GRAPHNOSIS_HOST_SKIP_BUILD=1

# ── Host-side secrets (set ON THE HOST, not usually here) ─────────────────
# Headless unlock needs a passphrase on the host:
#   printf '%s' 'YOUR_CORTEX_PASSPHRASE' > ~/.graphnosis/passphrase && chmod 600 ~/.graphnosis/passphrase
# Access token for laptop thin-client (read on host, paste into laptop UI yourself):
#   cat ~/.graphnosis/http-ui-token
# Do not commit tokens or passphrases. Do not paste them into tracked docs.
