# Local key-generation script for the GSK signing keypair. Generates a fresh
# Ed25519 keypair, writes the secret to ~/.graphnosis/gsk-signing.secret,
# patches the public key into gsk-format.ts. Never shipped.
scripts/gen-gsk-keypair.mjs

# Local pack-build tooling: builds the public trained-skills .gsk pack from a
# local skills.json, and checks whether GSK_SIGNING_KEY_HEX is the official
# key (MATCH/NO-MATCH; never prints the key). Not shipped — the pack is built
# + signed locally, then committed to the separate graphnosis-trained-skills
# repo, not this one.
apps/desktop-sidecar/scripts/build-trained-skills.mjs
apps/desktop-sidecar/scripts/check-gsk-key.mjs


# Author-side skill pack catalog (95+3 demos, all original prose). Stays
# local — the public-facing 95 packs ship as compiled .gsk files via the
# website downloads pipeline, not as source. The 3 bundled demos ship as
# base64-encoded .gsk bytes inside skill-demos.generated.ts (also gitignored;
# regenerated by the build).
apps/desktop-sidecar/src/default-skill-packs.ts

# Auto-generated from dist/packs/bundle/*.gsk by
# scripts/generate-skill-demos-content.mjs. The generator handles a
# missing bundle/ directory by writing an empty array, so fresh clones
# can still tsc-compile the sidecar even without the gitignored signing
# key / build-gsk.mjs that produce real bundled bytes.
apps/desktop-sidecar/src/skill-demos.generated.ts

