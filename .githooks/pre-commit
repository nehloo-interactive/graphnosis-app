#!/usr/bin/env bash
set -euo pipefail

# Always run the MAIN worktree's guard, never the one beside the commit.
#
# THE DEFECT THIS FIXES
# ---------------------
# This used to be `ROOT="$(git rev-parse --show-toplevel)"`, which resolves to
# whichever worktree the commit is being made from. Linked worktrees are
# checkouts of older commits, so each carries whatever version of the guard
# existed then — and a commit made from a stale worktree is checked by a stale
# guard.
#
# Not hypothetical: three linked worktrees carry the 54-line pre-hardening guard.
# In that version a real-name / real-project match sets `warned` rather than
# `blocked`, so the commit is allowed through with a line on stderr. The hardened
# guard turns that same category into `exit 1`, because this repository is PUBLIC
# and a warning nobody reads is not a control. (The hard `blocked` category still
# fails in both, so the stale copies are weaker, not absent.)
#
# A guard that gets weaker the older your checkout is has the ordering backwards.
#
# `--git-common-dir` resolves to the SHARED .git directory from every worktree,
# unlike `--git-dir`, which points at the per-worktree subdirectory. Its parent is
# the main working tree, wherever the commit is being made from.
GIT_COMMON="$(git rev-parse --path-format=absolute --git-common-dir)"
ROOT="$(cd "$(dirname "$GIT_COMMON")" && pwd)"
CHECKS="$ROOT/scripts/pre-commit-checks.sh"

# WHAT RUNS HERE
# --------------
# This used to exec scripts/pre-commit-guard.sh directly, which meant the guard
# was the ONLY pre-commit control: check-tests-allowlist.sh and
# check-disclosure-tags.sh were invoked by nothing at all, despite their headers
# claiming otherwise. It now execs the composite, which runs all four checks and
# prints a per-check verdict:
#
#   pre-commit-guard.sh        personal names / fixture data / smoketest artifacts
#   check-nul-bytes.sh         raw NUL bytes that make grep silently skip a file
#   check-tests-allowlist.sh   tests/ path policy
#   check-disclosure-tags.sh   (b)/(c) disclosure content policy
#
# The composite treats a MISSING member as a refusal, not a skip — see its
# header for why "did not run" must never look like "found nothing".

# Fail closed. A missing or non-executable composite means the checks did not
# run, and that must never be reported by silence — it is the same defect class
# as running the stale copy above.
if [ ! -x "$CHECKS" ]; then
  echo "pre-commit: checks not found or not executable at $CHECKS" >&2
  echo "pre-commit: refusing to commit unchecked. Use --no-verify only deliberately." >&2
  exit 1
fi

exec "$CHECKS"
